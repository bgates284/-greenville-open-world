{
  "name": "greenville-open-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open-world Greenville, NC in Three.js \u2014 real OpenStreetMap streets, Pitt County parcels, traffic, people and a plane at PGV.",
  "scripts": {
    "dev": "vite",
    "dev:plain": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "desktop": "node tools/build.mjs --desktop",
    "check": "node tools/check.mjs",
    "pack-data": "node tools/pack-data.mjs",
    "site": "node tools/build-site.mjs",
    "fetch-city": "node tools/fetch-city.mjs --pack",
    "fetch-canopy": "node tools/fetch-canopy.mjs",
    "fetch-transit": "node tools/fetch-transit.mjs"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "geotiff": "^2.1.3"
  }
}
